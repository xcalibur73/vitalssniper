{
  "manifest_version": 3,
  "name": "VitalsSniper: Proof-of-Flaw Web Inspector",
  "version": "1.3.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "vitalssniper@nbsolutions.com",
      "strict_min_version": "109.0"
    }
  },
  "description": "1-Click CMS & Builder detector, DOM bloat scanner, Core Web Vitals audit, and client outreach email generator.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://extensionpay.com/*",
    "https://vitalssniper-web.vercel.app/*",
    "https://www.webaudits.pro/*",
    "https://webaudits.pro/*",
    "https://www.googleapis.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Inspect active tab with VitalsSniper"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}